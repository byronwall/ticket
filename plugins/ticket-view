function chooseShape(counts, pooled) {
  const target = viewport.clientWidth / viewport.clientHeight;
  const attached = counts.some(rows => rows > 0);
  if (!(target > 0)) return { bands: 1, poolColumns: Math.ceil(Math.sqrt(pooled)) };
