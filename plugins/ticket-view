      width = Math.max(...widths);
      height = heights.reduce((sum, h) => sum + h + 72, 0);
    }
    if (columns) {
      width += columns * (NODE_W + POOL_GAP) + (attached ? POOL_SPLIT : 0);
      height = Math.max(height, Math.ceil(pooled / columns) * ROW_PITCH + 72);
    }
