const NODE_W = 240, NODE_H = 104, ROW_PITCH = 132, MIN_GAP = 64;
let rowCounts = [], bandCount = 1;
const bandOf = (column, bands, columns) => Math.floor(column * bands / columns);
// Wrap dependency columns into evenly sized, stacked bands when a single band
// would be far wider than the viewport. Returns the number of bands.
function chooseBandCount(counts) {
  const target = viewport.clientWidth / viewport.clientHeight;
  if (!counts.length || !(target > 0)) return 1;
  const score = bands => {
    const widths = new Array(bands).fill(0), heights = new Array(bands).fill(0);
    counts.forEach((rows, column) => {
      const b = bandOf(column, bands, counts.length);
      widths[b] += NODE_W + MIN_GAP;
      heights[b] = Math.max(heights[b], rows * ROW_PITCH);
    });
    const height = heights.reduce((sum, h) => sum + h + 72, 0);
    return Math.abs(Math.log((Math.max(...widths) + 72) / height / target));
  };
  if (score(1) < Math.log(1.35)) return 1;
  let best = 1;
  for (let bands = 2; bands <= counts.length; bands++) if (score(bands) < score(best) - 0.01) best = bands;
  return best;
}
