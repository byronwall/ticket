def tickets_from(directory):
    tickets = []
    for path in sorted(directory.glob("*.md")):
        content = path.read_text(encoding="utf-8", errors="replace")
        lines = content.splitlines()
        metadata = {}
        body_start = 0
        if lines and lines[0] == "---":
            for index, line in enumerate(lines[1:], 1):
                if line == "---":
                    body_start = index + 1
                    break
                if ":" in line:
                    key, value = line.split(":", 1)
                    metadata[key.strip()] = value.strip()
        body = "\n".join(lines[body_start:]).strip()
        heading = re.search(r"^#\s+(.+)$", body, re.MULTILINE)
        deps = metadata.get("deps", "[]").strip("[]")
        tickets.append({
            "id": path.stem,
            "title": heading.group(1) if heading else path.stem,
            "status": metadata.get("status", "open"),
            "type": metadata.get("type", "task"),
            "parent": metadata.get("parent", ""),
            "deps": [item.strip().strip("'\"") for item in deps.split(",") if item.strip()],
            "metadata": metadata,
            "body": body,
        })
    return tickets


def main():
    parser = argparse.ArgumentParser(description="Open a live ticket graph")
    parser.add_argument("--port", type=int, default=0, help="Local port (default: automatic)")
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser")
    args = parser.parse_args()
    directory = Path(os.environ.get("TICKETS_DIR", ".tickets")).expanduser().resolve()
    if not directory.is_dir():
        parser.error("No .tickets directory found; run from a ticket project")

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_GET(self):
            if self.path == "/api/tickets":
                try:
                    payload = json.dumps({
                        "project": str(directory.parent),
                        "tickets": tickets_from(directory),
                    }, ensure_ascii=False).encode()
                except OSError as error:
                    self.send_error(500, str(error))
                    return
                etag = hashlib.sha256(payload).hexdigest()
                if self.headers.get("If-None-Match") == etag:
                    self.send_response(304)
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("ETag", etag)
            elif self.path == "/":
                payload = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
            else:
                self.send_error(404)
                return
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    with ThreadingHTTPServer(("127.0.0.1", args.port), Handler) as server:
        url = "http://127.0.0.1:" + str(server.server_port)
        print("Ticket view: " + url, flush=True)
        if not args.no_open:
            webbrowser.open(url)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
