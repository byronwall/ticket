def tickets_from(directory):
    tickets = []
    if directory is None:
        return tickets
    for path in sorted(directory.glob("*.md")):
        content = path.read_text(encoding="utf-8", errors="replace")
        lines = content.splitlines()
        metadata = {}
        body_start = 0
        if lines and lines[0] == "---":
            for index, line in enumerate(lines[1:], 1):
                if line == "---":
                    body_start = index + 1
                    break
                if ":" in line:
                    key, value = line.split(":", 1)
                    metadata[key.strip()] = value.strip()
        body = "\n".join(lines[body_start:]).strip()
        heading = re.search(r"^#\s+(.+)$", body, re.MULTILINE)
        deps = metadata.get("deps", "[]").strip("[]")
        tickets.append({
            "id": path.stem,
            "title": heading.group(1) if heading else path.stem,
            "status": metadata.get("status", "open"),
            "type": metadata.get("type", "task"),
            "parent": metadata.get("parent", ""),
            "deps": [item.strip().strip("'\"") for item in deps.split(",") if item.strip()],
            "metadata": metadata,
            "body": body,
        })
    return tickets


SKIPPED_FOLDERS = {"node_modules", "dist", "build", "tmp", "vendor"}
ARTIFACT_LABELS = {"intent_brief": "Intent", "brainstorm": "Brainstorm", "shape_brief": "Shape", "implementation_plan": "Plan"}
MAX_DOCUMENTS = 80
MAX_DOCUMENT_BYTES = 2_000_000


def document_path(project, value):
    """Resolve a project-relative Markdown path. Returns None unless it names a
    readable Markdown file inside the project and outside hidden folders."""
    if not isinstance(value, str) or not value or "\x00" in value:
        return None
    relative = Path(value)
    if relative.is_absolute() or relative.suffix.lower() != ".md" or any(part.startswith(".") for part in relative.parts):
        return None
    try:
        path = (project / relative).resolve()
        if project not in path.parents or not path.is_file() or path.stat().st_size > MAX_DOCUMENT_BYTES:
            return None
    except OSError:
        return None
    return path


def document_title(path):
    """Return the first top-level heading of a Markdown file, or ''."""
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            head = handle.read(8192)
    except OSError:
        return ""
    match = re.search(r"^#\s+(.+?)\s*#*\s*$", head, re.MULTILINE)
    return match.group(1).strip() if match else ""


def documents_from(project, folder, artifacts):
    """List an initiative's Markdown files: the lifecycle artifacts first, then
    other artifacts in map order, then the remaining files by path."""
    roles = {}
    if isinstance(artifacts, dict):
        for key, value in artifacts.items():
            target = value.get("path") if isinstance(value, dict) else None
            if isinstance(target, str) and target.lower().endswith(".md"):
                roles.setdefault((folder / target).resolve(), (key, value))
    found = []
    for parent, dirs, files in os.walk(folder):
        dirs[:] = sorted(name for name in dirs if not name.startswith(".") and name not in SKIPPED_FOLDERS
                         and not (Path(parent) / name / "initiative-map.json").is_file())
        found.extend((Path(parent) / name).resolve() for name in sorted(files) if name.lower().endswith(".md"))
    found.extend(path for path in roles if path not in found)
    order = list(ARTIFACT_LABELS) + [key for key, _ in roles.values()]
    found.sort(key=lambda path: order.index(roles[path][0]) if path in roles else len(order))
    documents = []
    for path in found[:MAX_DOCUMENTS]:
        try:
            relative = path.relative_to(project).as_posix()
            if not document_path(project, relative):
                continue
            version = str(path.stat().st_mtime_ns)
        except (OSError, ValueError):
            continue
        key, artifact = roles.get(path, ("", {}))
        name = path.relative_to(folder).as_posix() if folder in path.parents else relative
        label = ARTIFACT_LABELS.get(key) or (key or name[:-3]).replace("_", " ").replace("-", " ").replace("/", " / ")
        documents.append({
            "path": relative,
            "name": name,
            "label": label[:1].upper() + label[1:],
            "role": key,
            "title": document_title(path),
            "status": artifact.get("status") if isinstance(artifact.get("status"), str) else "",
            "updated": artifact.get("updated_at") if isinstance(artifact.get("updated_at"), str) else "",
            "version": version,
        })
    return documents


def initiatives_from(project, tickets):
    initiatives = []
    errors = []
    for folder, dirs, files in os.walk(project):
        dirs[:] = sorted(name for name in dirs if not name.startswith(".") and name not in SKIPPED_FOLDERS)
        if "initiative-map.json" not in files:
            continue
        path = Path(folder) / "initiative-map.json"
        relative = path.relative_to(project).as_posix()
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            info = data["initiative"]
            implementation = data.get("implementation", {})
            if not isinstance(info, dict) or not isinstance(info.get("title"), str) or not info["title"].strip():
                raise ValueError("Expected an initiative title")
            if not isinstance(implementation, dict) or not isinstance(implementation.get("milestones", []), list):
                raise ValueError("Expected an implementation object and milestone list")
            if any(not isinstance(item, dict) or not isinstance(item.get("status", ""), str) for item in implementation.get("milestones", [])):
                raise ValueError("Expected milestone objects with text states")
            if not all(isinstance(implementation.get(key, ""), str) for key in ("status", "execution_status")):
                raise ValueError("Expected text implementation states")
        except (OSError, UnicodeError, ValueError, KeyError, TypeError) as error:
            errors.append(f"{relative}: {error}")
            continue
        # ponytail: path references link tickets; use explicit initiative IDs
        # if references become ambiguous. The slash separates similar slugs.
        reference = path.parent.relative_to(project).as_posix() + "/"
        ids = set()

        def collect_ids(value):
            if isinstance(value, str):
                ids.add(value)
            elif isinstance(value, list):
                for item in value:
                    collect_ids(item)
            elif isinstance(value, dict):
                for key, item in value.items():
                    if key not in {"dependencies", "dependency_edges", "coverage"}:
                        collect_ids(item)

        for value in (data.get("tickets"), implementation.get("tickets"), implementation.get("ticket_graph")):
            collect_ids(value)
        linked = [ticket for ticket in tickets if ticket["id"] in ids or reference in ticket["body"] or reference in ticket["metadata"].get("external-ref", "")]
        states = [ticket["status"] for ticket in linked if ticket["type"] != "epic"]
        if not states:
            states = [ticket["status"] for ticket in linked]
        milestones = [item.get("status", "") for item in implementation.get("milestones", [])]
        done = {"closed", "done", "complete", "completed"}
        started = {"in_progress", "in-progress", "started", "partially_implemented", "partial"}
        execution = implementation.get("execution_status", "")
        map_complete = execution in done or implementation.get("status") in done or (milestones and all(state in done for state in milestones))
        map_started = execution in started or implementation.get("status") in started or any(state in done | started for state in milestones)
        if states:
            complete = all(state in done for state in states) and (not milestones or map_complete)
            if complete:
                status = "Complete"
            elif map_started or map_complete or any(state in done | started for state in states):
                status = "Started"
            else:
                status = "No recorded start"
            evidence = f"{len(states)} linked tickets; {sum(state in done for state in states)} closed."
        elif map_complete:
            status, evidence = "Complete", "Completion recorded in the map."
        elif map_started:
            status, evidence = "Started", "Work recorded in the map."
        else:
            status, evidence = "No recorded start", "No linked tickets or map states show that work has started."
        documents = documents_from(project, path.parent.resolve(), data.get("artifacts"))
        version = path.stat().st_mtime_ns
        initiatives.append({
            "path": relative,
            "slug": initiative_slug(path, info),
            "map": data,
            "status": status,
            "evidence": evidence,
            "tickets": [ticket["id"] for ticket in linked],
            "documents": documents,
            "version": str(version),
            # Newest edit to the map or any of its documents, in milliseconds.
            "modified": max([version] + [int(doc["version"]) for doc in documents]) // 1_000_000,
        })
    initiatives.sort(key=lambda item: (item["status"] != "No recorded start", item["map"]["initiative"]["title"].casefold()))
    return initiatives, errors


LIFECYCLE = ("planned", "active", "paused", "completed", "cancelled")
PHASES = ("intent", "brainstorm", "shape", "plan", "execution", "reconciliation")


def initiative_slug(path, info):
    slug = info.get("slug")
    return slug if isinstance(slug, str) and slug.strip() else path.parent.name


def initiative_dependencies(info):
    value = info.get("depends_on")
    return [item for item in value if isinstance(item, str)] if isinstance(value, list) else []


def write_initiative(project, relative, version, changes, today):
    """Apply status, phase, next action, or dependency changes to one map.
    Keeps the file's indentation, stamps last_updated, and records a history
    entry. Raises RuntimeError when the map changed since `version`."""
    path = (project / relative).resolve()
    if path.name != "initiative-map.json" or project not in path.parents or not path.is_file():
        raise LookupError("Initiative map not found")
    if str(path.stat().st_mtime_ns) != version:
        raise RuntimeError("The initiative map changed; try again")
    content = path.read_text(encoding="utf-8")
    data = json.loads(content)
    info = data["initiative"]
    events = []
    if "status" in changes:
        if changes["status"] not in LIFECYCLE:
            raise ValueError("Invalid initiative status")
        events.append(f"Status set to {changes['status']} (was {info.get('status') or 'unset'}).")
        info["status"] = changes["status"]
    if "current_phase" in changes:
        if changes["current_phase"] not in PHASES:
            raise ValueError("Invalid initiative phase")
        events.append(f"Phase set to {changes['current_phase']} (was {info.get('current_phase') or 'unset'}).")
        info["current_phase"] = changes["current_phase"]
    if "next_action" in changes:
        text = changes["next_action"]
        if not isinstance(text, str) or len(text) > 1000:
            raise ValueError("Invalid next action")
        events.append("Next action updated.")
        info["next_action"] = text.strip()
    if "depends_on" in changes:
        slugs = changes["depends_on"]
        if not isinstance(slugs, list) or not all(isinstance(item, str) for item in slugs):
            raise ValueError("Invalid dependencies")
        maps = {}
        for folder, dirs, files in os.walk(project):
            dirs[:] = [name for name in dirs if not name.startswith(".") and name not in SKIPPED_FOLDERS]
            if "initiative-map.json" in files:
                other = Path(folder) / "initiative-map.json"
                try:
                    other_info = json.loads(other.read_text(encoding="utf-8"))["initiative"]
                    maps[initiative_slug(other, other_info)] = initiative_dependencies(other_info)
                except (OSError, UnicodeError, ValueError, KeyError, TypeError, AttributeError):
                    continue
        own = initiative_slug(path, info)
        slugs = list(dict.fromkeys(slugs))
        if own in slugs:
            raise ValueError("An initiative cannot depend on itself")
        missing = [slug for slug in slugs if slug not in maps]
        if missing:
            raise ValueError("Unknown initiative: " + ", ".join(missing))
        maps[own] = slugs
        pending, seen = list(slugs), set()
        while pending:
            current = pending.pop()
            if current == own:
                raise ValueError("That dependency would create a cycle")
            if current not in seen:
                seen.add(current)
                pending.extend(maps.get(current, []))
        before = initiative_dependencies(info)
        added, removed = [s for s in slugs if s not in before], [s for s in before if s not in slugs]
        events.append("Dependencies changed: " + "; ".join(filter(None, [
            added and "added " + ", ".join(added), removed and "removed " + ", ".join(removed)])) + ".")
        info["depends_on"] = slugs
    if not events:
        raise ValueError("Nothing to change")
    info["last_updated"] = today
    if isinstance(data.get("history"), list):
        data["history"].append({"date": today, "event": "updated-in-tk-view", "action": " ".join(events)})
    indent = re.match(r"\{\r?\n([ \t]+)", content)
    text = json.dumps(data, indent=indent.group(1) if indent else 2, ensure_ascii=False)
    if content.endswith("\n"):
        text += "\n"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write(text.encode("utf-8"))
        os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        os.replace(temporary, path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


def write_assignee(path, expected, name):
    content = path.read_bytes().decode("utf-8")
    lines = content.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError("Ticket has no front matter")
    end = next((index for index, line in enumerate(lines[1:], 1) if line.strip() == "---"), None)
    if end is None:
        raise ValueError("Ticket has no front matter")
    index = next((index for index in range(1, end) if lines[index].lstrip().startswith("assignee:")), None)
    current = lines[index].split(":", 1)[1].strip() if index is not None else ""
    if current != expected:
        raise RuntimeError("Ticket assignee changed; try again")
    newline = "\r\n" if "\r\n" in content else "\n"
    if index is not None:
        lines[index:index + 1] = [f"assignee: {name}{newline}"] if name else []
    elif name:
        lines.insert(end, f"assignee: {name}{newline}")
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write("".join(lines).encode("utf-8"))
        os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        os.replace(temporary, path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


def write_dependencies(path, deps):
    content = path.read_bytes().decode("utf-8")
    lines = content.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError("Ticket has no front matter")
    end = next((index for index, line in enumerate(lines[1:], 1) if line.strip() == "---"), None)
    if end is None:
        raise ValueError("Ticket has no front matter")
    index = next((index for index in range(1, end) if re.match(r"^deps\s*:", lines[index])), None)
    newline = "\r\n" if "\r\n" in content else "\n"
    line = f"deps: [{', '.join(deps)}]{newline}"
    if index is None:
        lines.insert(end, line)
    else:
        lines[index] = line
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write("".join(lines).encode("utf-8"))
        os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        os.replace(temporary, path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


def would_cycle(tickets, source, target):
    graph = {ticket["id"]: ticket["deps"] for ticket in tickets}
    pending, seen = [source], set()
    while pending:
        current = pending.pop()
        if current == target:
            return True
        if current not in seen:
            seen.add(current)
            pending.extend(graph.get(current, []))
    return False


def find_project():
    """Return (project, tickets directory or None). TICKETS_DIR wins; otherwise
    the nearest parent with .tickets/, then the git root, then the working
    directory, so projects with only initiative documents still open."""
    explicit = os.environ.get("TICKETS_DIR", "")
    if explicit:
        directory = Path(explicit).expanduser().resolve()
        return (directory.parent, directory) if directory.is_dir() else (None, None)
    here = Path.cwd().resolve()
    for folder in (here, *here.parents):
        if (folder / ".tickets").is_dir():
            return folder, folder / ".tickets"
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=here, capture_output=True, text=True)
        if root.returncode == 0 and root.stdout.strip():
            return Path(root.stdout.strip()).resolve(), None
    except OSError:
        pass
    return here, None


def main():
    parser = argparse.ArgumentParser(description="Open a live ticket graph")
    parser.add_argument("--port", type=int, default=0, help="Local port (default: automatic)")
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser")
    args = parser.parse_args()
    project, directory = find_project()
    if project is None:
        parser.error("Tickets directory not found: " + os.environ["TICKETS_DIR"])
    local_ticket = Path(__file__).resolve().parent.parent / "ticket"
    ticket_command = os.environ.get("TK_SCRIPT") or (str(local_ticket) if local_ticket.is_file() else None) or shutil.which("ticket") or shutil.which("tk")
    dependency_lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def send_json(self, status, data):
            payload = json.dumps(data).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def do_POST(self):
            if self.path not in ("/api/status", "/api/assignee", "/api/dependency", "/api/initiative"):
                self.send_error(404)
                return
            origin = self.headers.get("Origin")
            host = self.headers.get("Host")
            allowed_hosts = {f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}"}
            if host not in allowed_hosts or (origin and origin != f"http://{host}"):
                self.send_json(403, {"error": "Invalid request origin"})
                return
            if self.headers.get("Content-Type", "").split(";", 1)[0] != "application/json":
                self.send_json(415, {"error": "Expected JSON request"})
                return
            if self.path == "/api/initiative":
                try:
                    length = int(self.headers.get("Content-Length", "0"))
                    if not 0 < length <= 16384:
                        raise ValueError()
                    data = json.loads(self.rfile.read(length))
                    relative, version, changes = data["path"], data["version"], data["changes"]
                    if not isinstance(relative, str) or not isinstance(version, str) or not isinstance(changes, dict):
                        raise ValueError()
                except (ValueError, KeyError, TypeError):
                    self.send_json(400, {"error": "Invalid initiative update request"})
                    return
                today = data.get("today") if isinstance(data.get("today"), str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", data.get("today")) else time.strftime("%Y-%m-%d")
                with dependency_lock:
                    try:
                        write_initiative(project, relative, version, changes, today)
                    except LookupError as error:
                        self.send_json(404, {"error": str(error)})
                        return
                    except RuntimeError as error:
                        self.send_json(409, {"error": str(error)})
                        return
                    except (OSError, UnicodeError, ValueError, KeyError, TypeError) as error:
                        self.send_json(400, {"error": str(error)})
                        return
                self.send_json(200, {"path": relative})
                return
            if directory is None:
                self.send_json(404, {"error": "This project has no .tickets directory"})
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if not 0 < length <= 4096:
                    raise ValueError()
                data = json.loads(self.rfile.read(length))
                if self.path == "/api/dependency":
                    source, target, action = data["from"], data["to"], data["action"]
                    if not all(isinstance(item, str) for item in (source, target, action)):
                        raise ValueError()
                else:
                    ticket_id = data["id"]
                    expected = data["expectedStatus" if self.path == "/api/status" else "expectedAssignee"]
                    value = data["status" if self.path == "/api/status" else "name"]
                    if not all(isinstance(item, str) for item in (ticket_id, expected, value)):
                        raise ValueError()
            except (ValueError, KeyError, TypeError):
                self.send_json(400, {"error": "Invalid ticket update request"})
                return
            if self.path == "/api/dependency":
                if action not in ("add", "remove") or source == target:
                    self.send_json(400, {"error": "Invalid dependency"})
                    return
                with dependency_lock:
                    tickets = tickets_from(directory)
                    mapped = {ticket["id"]: ticket for ticket in tickets}
                    if source not in mapped or target not in mapped:
                        self.send_json(404, {"error": "Ticket not found"})
                        return
                    deps = mapped[target]["deps"]
                    if (action == "add" and source in deps) or (action == "remove" and source not in deps):
                        self.send_json(409, {"error": "Dependency already exists" if action == "add" else "Dependency no longer exists"})
                        return
                    if action == "add" and would_cycle(tickets, source, target):
                        self.send_json(409, {"error": "Connection would create a dependency cycle"})
                        return
                    next_deps = deps + [source] if action == "add" else [dep for dep in deps if dep != source]
                    try:
                        write_dependencies(directory / f"{target}.md", next_deps)
                    except (OSError, UnicodeError, ValueError) as error:
                        self.send_json(400, {"error": str(error)})
                        return
                self.send_json(200, {"from": source, "to": target, "action": action})
                return
            current = next((ticket for ticket in tickets_from(directory) if ticket["id"] == ticket_id), None)
            if not current:
                self.send_json(404, {"error": "Ticket not found"})
                return
            if self.path == "/api/assignee":
                name = value.strip()
                if len(name) > 80 or not name.isprintable() or any(char in name for char in "#:"):
                    self.send_json(400, {"error": "Invalid assignee name"})
                    return
                try:
                    write_assignee(directory / f"{ticket_id}.md", expected, name)
                except RuntimeError as error:
                    self.send_json(409, {"error": str(error)})
                    return
                except (OSError, UnicodeError, ValueError) as error:
                    self.send_json(400, {"error": str(error)})
                    return
                self.send_json(200, {"assignee": name})
                return
            status = value
            if status not in ("open", "ready", "in_progress", "partially_implemented", "closed"):
                self.send_json(400, {"error": "Invalid status"})
                return
            if current["status"] != expected:
                self.send_json(409, {"error": "Ticket status changed; try again"})
                return
            if not ticket_command:
                self.send_json(503, {"error": "Ticket command not found"})
                return
            try:
                result = subprocess.run([ticket_command, "super", "status", ticket_id, status],
                                        cwd=project, env={**os.environ, "TICKETS_DIR": str(directory)},
                                        capture_output=True, text=True)
            except OSError:
                self.send_json(503, {"error": "Ticket command unavailable"})
                return
            if result.returncode:
                self.send_json(400, {"error": result.stderr.strip() or "Status update failed"})
                return
            self.send_json(200, {"status": status})

        def do_GET(self):
            request = urlsplit(self.path)
            if request.path == "/api/doc":
                if self.headers.get("Host") not in {f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}"}:
                    self.send_json(403, {"error": "Invalid request origin"})
                    return
                relative = parse_qs(request.query).get("path", [""])[0]
                target = document_path(project, relative)
                if not target:
                    self.send_json(404, {"error": "Document not found: " + relative})
                    return
                try:
                    text = target.read_text(encoding="utf-8", errors="replace")
                except OSError as error:
                    self.send_json(500, {"error": str(error)})
                    return
                self.send_json(200, {"path": relative, "text": text})
                return
            if request.path == "/api/tickets":
                try:
                    tickets = tickets_from(directory)
                    initiatives, errors = initiatives_from(project, tickets)
                    payload = json.dumps({
                        "project": str(project),
                        "has_tickets": directory is not None,
                        "tickets": tickets,
                        "initiatives": initiatives,
                        "initiative_errors": errors,
                    }, ensure_ascii=False).encode()
                except OSError as error:
                    self.send_error(500, str(error))
                    return
                etag = hashlib.sha256(payload).hexdigest()
                if self.headers.get("If-None-Match") == etag:
                    self.send_response(304)
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("ETag", etag)
            elif request.path == "/":
                payload = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
            else:
                self.send_error(404)
                return
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    with ThreadingHTTPServer(("127.0.0.1", args.port), Handler) as server:
        url = "http://127.0.0.1:" + str(server.server_port)
        print("Ticket view: " + url, flush=True)
        if not args.no_open:
            webbrowser.open(url)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
