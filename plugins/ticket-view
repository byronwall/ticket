def tickets_from(directory):
    tickets = []
    for path in sorted(directory.glob("*.md")):
        content = path.read_text(encoding="utf-8", errors="replace")
        lines = content.splitlines()
        metadata = {}
        body_start = 0
        if lines and lines[0] == "---":
            for index, line in enumerate(lines[1:], 1):
                if line == "---":
                    body_start = index + 1
                    break
                if ":" in line:
                    key, value = line.split(":", 1)
                    metadata[key.strip()] = value.strip()
        body = "\n".join(lines[body_start:]).strip()
        heading = re.search(r"^#\s+(.+)$", body, re.MULTILINE)
        deps = metadata.get("deps", "[]").strip("[]")
        tickets.append({
            "id": path.stem,
            "title": heading.group(1) if heading else path.stem,
            "status": metadata.get("status", "open"),
            "type": metadata.get("type", "task"),
            "parent": metadata.get("parent", ""),
            "deps": [item.strip().strip("'\"") for item in deps.split(",") if item.strip()],
            "metadata": metadata,
            "body": body,
        })
    return tickets


def write_assignee(path, expected, name):
    content = path.read_bytes().decode("utf-8")
    lines = content.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError("Ticket has no front matter")
    end = next((index for index, line in enumerate(lines[1:], 1) if line.strip() == "---"), None)
    if end is None:
        raise ValueError("Ticket has no front matter")
    index = next((index for index in range(1, end) if lines[index].lstrip().startswith("assignee:")), None)
    current = lines[index].split(":", 1)[1].strip() if index is not None else ""
    if current != expected:
        raise RuntimeError("Ticket assignee changed; try again")
    newline = "\r\n" if "\r\n" in content else "\n"
    if index is not None:
        lines[index:index + 1] = [f"assignee: {name}{newline}"] if name else []
    elif name:
        lines.insert(end, f"assignee: {name}{newline}")
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write("".join(lines).encode("utf-8"))
        os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        os.replace(temporary, path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description="Open a live ticket graph")
    parser.add_argument("--port", type=int, default=0, help="Local port (default: automatic)")
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser")
    args = parser.parse_args()
    directory = Path(os.environ.get("TICKETS_DIR", ".tickets")).expanduser().resolve()
    if not directory.is_dir():
        parser.error("No .tickets directory found; run from a ticket project")
    local_ticket = Path(__file__).resolve().parent.parent / "ticket"
    ticket_command = os.environ.get("TK_SCRIPT") or (str(local_ticket) if local_ticket.is_file() else None) or shutil.which("ticket") or shutil.which("tk")

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def send_json(self, status, data):
            payload = json.dumps(data).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def do_POST(self):
            if self.path not in ("/api/status", "/api/assignee"):
                self.send_error(404)
                return
            origin = self.headers.get("Origin")
            host = self.headers.get("Host")
            allowed_hosts = {f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}"}
            if host not in allowed_hosts or (origin and origin != f"http://{host}"):
                self.send_json(403, {"error": "Invalid request origin"})
                return
            if self.headers.get("Content-Type", "").split(";", 1)[0] != "application/json":
                self.send_json(415, {"error": "Expected JSON request"})
                return
