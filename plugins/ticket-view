                length = int(self.headers.get("Content-Length", "0"))
                if not 0 < length <= 4096:
                    raise ValueError()
                data = json.loads(self.rfile.read(length))
                ticket_id = data["id"]
                expected = data["expectedStatus" if self.path == "/api/status" else "expectedAssignee"]
                value = data["status" if self.path == "/api/status" else "name"]
                if not all(isinstance(item, str) for item in (ticket_id, expected, value)):
                    raise ValueError()
            except (ValueError, KeyError, TypeError):
                self.send_json(400, {"error": "Invalid ticket update request"})
                return
            current = next((ticket for ticket in tickets_from(directory) if ticket["id"] == ticket_id), None)
            if not current:
                self.send_json(404, {"error": "Ticket not found"})
                return
            if self.path == "/api/assignee":
                name = value.strip()
                if len(name) > 80 or not name.isprintable() or any(char in name for char in "#:"):
                    self.send_json(400, {"error": "Invalid assignee name"})
                    return
                try:
                    write_assignee(directory / f"{ticket_id}.md", expected, name)
                except RuntimeError as error:
                    self.send_json(409, {"error": str(error)})
                    return
                except (OSError, UnicodeError, ValueError) as error:
                    self.send_json(400, {"error": str(error)})
                    return
                self.send_json(200, {"assignee": name})
                return
            status = value
            if status not in ("open", "ready", "in_progress", "closed"):
                self.send_json(400, {"error": "Invalid status"})
                return
            if current["status"] != expected:
                self.send_json(409, {"error": "Ticket status changed; try again"})
                return
            if not ticket_command:
                self.send_json(503, {"error": "Ticket command not found"})
                return
            try:
                result = subprocess.run([ticket_command, "super", "status", ticket_id, status],
                                        cwd=directory.parent, env={**os.environ, "TICKETS_DIR": str(directory)},
                                        capture_output=True, text=True)
            except OSError:
                self.send_json(503, {"error": "Ticket command unavailable"})
                return
            if result.returncode:
                self.send_json(400, {"error": result.stderr.strip() or "Status update failed"})
                return
            self.send_json(200, {"status": status})

        def do_GET(self):
            if self.path == "/api/tickets":
                try:
                    payload = json.dumps({
                        "project": str(directory.parent),
                        "tickets": tickets_from(directory),
                    }, ensure_ascii=False).encode()
                except OSError as error:
                    self.send_error(500, str(error))
                    return
                etag = hashlib.sha256(payload).hexdigest()
                if self.headers.get("If-None-Match") == etag:
                    self.send_response(304)
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("ETag", etag)
            elif self.path == "/":
                payload = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
            else:
                self.send_error(404)
                return
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    with ThreadingHTTPServer(("127.0.0.1", args.port), Handler) as server:
        url = "http://127.0.0.1:" + str(server.server_port)
        print("Ticket view: " + url, flush=True)
        if not args.no_open:
            webbrowser.open(url)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


